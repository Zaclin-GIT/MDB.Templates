{
  "$schema": "http://json.schemastore.org/template",
  "author": "MDB Framework",
  "classifications": [
    "Library",
    "Modding",
    "Unity",
    "IL2CPP",
    "MDB"
  ],
  "identity": "MDB.Mod.Template",
  "name": "MDB Mod",
  "shortName": "mdbmod",
  "description": "A mod project for MDB Framework (Unity IL2CPP modding)",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "defaultName": "MyMod",
  "preferNameDirectory": true,
  "sourceName": "MDBModTemplate",
  "symbols": {
    "ModAuthor": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "ModAuthor",
      "description": "Your mod author name",
      "replaces": "MOD_AUTHOR"
    },
    "ModDescription": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "An MDB Framework mod",
      "description": "A short description of your mod",
      "replaces": "MOD_DESCRIPTION"
    },
    "GamePath": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "GAME_FOLDER_HERE",
      "description": "Absolute path to the game folder (where the .exe is)",
      "replaces": "GAME_PATH_TOKEN"
    },
    "imgui": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include ImGui UI boilerplate"
    },
    "modId": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          { "type": "ref", "value": "ModAuthor" },
          { "type": "ref", "value": "name" }
        ],
        "separator": "."
      },
      "replaces": "MOD_ID_TOKEN"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!imgui)",
          "exclude": [ "ImGuiWindow.cs" ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "manualInstructions": [
        { "text": "Run 'dotnet restore'" }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
